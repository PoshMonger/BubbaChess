# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files.
# Ignore every .env* file so real URLs and per-machine config never land in git...
.env*
# ...except .env.example, which is the committed template everyone copies from.
# This negation MUST come after the pattern above: with git, the LAST matching rule wins.
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
