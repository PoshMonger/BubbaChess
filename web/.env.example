# TEMPLATE — this is the only .env file committed to git (see .gitignore).
# Copy it three times and fill in the values for each environment:
#
#   cp .env.example .env.localhost     # used by: npm run dev
#   cp .env.example .env.development   # used by: npm run dev-development / build-development
#   cp .env.example .env.production    # used by: npm run dev-production / build-production
#
# WARNING: only variables starting with VITE_ are visible to the app, and Vite pastes their
# values directly into the JavaScript bundle that gets sent to browsers. Treat every value
# here as PUBLIC. Real secrets (JWT secrets, Mongo passwords) belong in /api's env files,
# which run on the server and are never shipped to the client.

# Which environment this is: localhost | development | production
VITE_NODE_ENV=localhost

# Base URL of the /api backend, no trailing slash. The API listens on port 3000 locally.
VITE_API_URL=http://localhost:3000
